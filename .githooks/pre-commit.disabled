#!/bin/bash
# Pre-commit hook: Tu dong dong bo hoa ban dich README
# Chi kich hoat khi README.md bi sua doi

# Kiem tra README.md co bi sua doi trong lan commit nay khong
if git diff --cached --name-only | grep -q "^README.md$"; then
    echo "Phat hien thay doi README.md, dang tu dong dong bo ban dich..."
    
    # Kiem tra thu muc goc
    if [ ! -f "README.md" ]; then
        echo "Loi: Khong tim thay README.md"
        exit 1
    fi
    
    # Kiem tra file .env
    if [ ! -f ".env" ]; then
        echo "Canh bao: Khong tim thay file .env, bo qua tu dong dich"
        exit 0
    fi
    
    # Chay script dich
    if [ -f "backend/scripts/translate_readme.py" ]; then
        python backend/scripts/translate_readme.py --target-langs en
        
        if [ $? -eq 0 ]; then
            echo "Ban dich README thanh cong!"
            git add README_EN.md docs/i18n/
        else
            echo "Canh bao: Dich README that bai, vui long kiem tra cau hinh API key"
            exit 0
        fi
    fi
fi

exit 0
