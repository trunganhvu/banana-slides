# ==============================================================================
# I. Cấu hình tối thiểu (Chọn một nhà cung cấp để chạy)
# ==============================================================================
# Định dạng AI Provider
# "gemini" (mặc định): Sử dụng Google GenAI SDK
# "openai": Sử dụng định dạng OpenAI SDK
# "volcengine": Sử dụng Volcengine Ark AgentPlans (tương thích OpenAI)
# "anthropic": Sử dụng định dạng Anthropic (Claude) SDK
AI_PROVIDER_FORMAT=gemini

# Cấu hình định dạng Gemini (sử dụng khi AI_PROVIDER_FORMAT=gemini)
GOOGLE_API_KEY=your-api-key-here
# Ví dụ proxy: https://api.inferera.com/gemini
GOOGLE_API_BASE=https://generativelanguage.googleapis.com
# Thời gian chờ GenAI (Gemini) tính bằng giây, mặc định 300 giây
GENAI_TIMEOUT=300.0
# Số lần thử lại tối đa cho GenAI (Gemini), mặc định 2 lần
GENAI_MAX_RETRIES=2

# Cấu hình định dạng OpenAI (sử dụng khi AI_PROVIDER_FORMAT=openai)
OPENAI_API_KEY=your-api-key-here
# Ví dụ proxy: https://api.inferera.com/v1
OPENAI_API_BASE=https://api.openai.com/v1
# Thời gian chờ (giây), mặc định 300 giây
OPENAI_TIMEOUT=300.0
# Số lần thử lại tối đa, mặc định 2 lần
OPENAI_MAX_RETRIES=2

# Cấu hình Volcengine Ark Agent Plans (sử dụng khi AI_PROVIDER_FORMAT=volcengine)
# Lưu ý: Agent Plan cần API Key và tên mô hình riêng (doubao-seed-2.1-turbo / doubao-seedream-5.0-lite)
VOLCENGINE_API_KEY=your-volcengine-api-key-here
VOLCENGINE_API_BASE=https://ark.cn-beijing.volces.com/api/plan/v3

# Cấu hình định dạng Anthropic (Claude) (sử dụng khi AI_PROVIDER_FORMAT=anthropic)
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_API_BASE=https://api.anthropic.com
ANTHROPIC_VERSION=2023-06-01
# Global output limit for text generation and image understanding
TEXT_MAX_OUTPUT_TOKENS=32768
# Legacy ANTHROPIC_MAX_TOKENS is used only when TEXT_MAX_OUTPUT_TOKENS is unset.

# Cấu hình định dạng LazyLLM (sử dụng khi AI_PROVIDER_FORMAT=lazyllm)
# Chọn nhà cung cấp cho mô hình tạo văn bản, tạo ảnh và mô tả ảnh
# TEXT_MODEL_SOURCE=
# IMAGE_MODEL_SOURCE=
# IMAGE_CAPTION_MODEL_SOURCE=
# Cho phép LazyLLM truy cập mạng nội bộ/riêng tư (như S3 nội bộ), khắc phục lỗi tải ảnh
LAZYLLM_ALLOW_INTERNAL_NETWORK=True

# API Key các nhà cung cấp khác (chỉ cần cấu hình nhà cung cấp tương ứng với mô hình bạn dùng)
# Định dạng chung: {SOURCE}_API_KEY
DOUBAO_API_KEY=your-doubao-api-key
QWEN_API_KEY=your-qwen-api-key
DEEPSEEK_API_KEY=your-deepseek-api-key
GLM_API_KEY=your-glm-api-key
SILICONFLOW_API_KEY=your-siliconflow-api-key
SENSENOVA_API_KEY=your-sensenova-api-key  # Đường dẫn LazyLLM cũ; đối với tạo ảnh U1 hãy ưu tiên cấu hình IMAGE_* bên dưới
MINIMAX_API_KEY=your-minimax-api-key

# ==============================================================================
# II. Cấu hình nâng cao: Sử dụng nhà cung cấp khác nhau cho từng loại mô hình
# ==============================================================================
# Cho phép text, image, image_caption sử dụng API riêng biệt
# Thứ tự ưu tiên: Cấu hình riêng từng mô hình > Cấu hình toàn cục
# ------------------------------
# Ví dụ: Ba mô hình dùng ba API khác nhau
# ------------------------------
# # Cấu hình mô hình văn bản
# TEXT_MODEL_SOURCE=openai|anthropic|gemini|...
# TEXT_API_KEY=text_model_api_key
# TEXT_API_BASE=https://text-model-api.com/v1
# TEXT_MODEL=gpt-4o
#
# # Cấu hình mô hình tạo ảnh
# IMAGE_MODEL_SOURCE=openai|anthropic|gemini|...
# IMAGE_API_KEY=image_model_api_key
# IMAGE_API_BASE=https://image-model-api.com/v1
# IMAGE_MODEL=gemini-2.5-flash-image-preview
#
# # SenseNova U1.5 Lite (tạo ảnh + chỉnh sửa ảnh tham chiếu; khuyến nghị chỉ định riêng cho ảnh)
# IMAGE_MODEL_SOURCE=openai
# IMAGE_API_KEY=your-sensenova-api-key
# IMAGE_API_BASE=https://token.sensenova.cn/v1
# IMAGE_MODEL=sensenova-u1.5-lite
#
# # Cấu hình mô hình nhận diện ảnh
# IMAGE_CAPTION_MODEL_SOURCE=openai|anthropic|gemini|...
# IMAGE_CAPTION_API_KEY=caption_model_api_key
# IMAGE_CAPTION_API_BASE=https://caption-model-api.com/v1
# IMAGE_CAPTION_MODEL=claude-3-5-sonnet-20241022

# # Cấu hình mô hình AI
# TEXT_MODEL=gemini-3-flash-preview
# IMAGE_MODEL=gemini-3-pro-image-preview
# # Cấu hình mô hình nhận diện ảnh (dùng để tạo mô tả cho ảnh trong tài liệu tải lên)
# IMAGE_CAPTION_MODEL=gemini-3-flash-preview

# Cấu hình Flask
LOG_LEVEL=INFO
# Flask/Werkzeug HTTP access logs; set to WARNING locally to quiet polling noise.
# WERKZEUG_LOG_LEVEL=WARNING
FLASK_ENV=production
SECRET_KEY=your-secret-key-change-this-in-production
# BACKEND_PORT / FRONTEND_PORT — Để trống sẽ tự động tính cổng theo tên thư mục worktree (xem app.py / vite.config.ts)
BACKEND_PORT=5011
FRONTEND_PORT=3011

# Cấu hình CORS (nhiều địa chỉ phân tách bằng dấu phẩy)
CORS_ORIGINS=*

# Cấu hình xử lý đồng thời
MAX_DESCRIPTION_WORKERS=5
MAX_IMAGE_WORKERS=8

# Cấu hình dịch vụ phân tích tài liệu MinerU
# Lấy token tại: https://mineru.net/apiManage/token , lưu ý thời hạn sử dụng
MINERU_TOKEN=your-mineru-token
MINERU_API_BASE=https://mineru.net

# Cấu hình dịch vụ xuất PPTX có thể chỉnh sửa
BAIDU_API_KEY=you-baidu-api-key

# Mã truy cập (để trống nếu không bật xác thực mã truy cập)
# ACCESS_CODE=your-access-code-here

# Cấu hình ngôn ngữ đầu ra
# Giá trị tùy chọn: 'vi' (Tiếng Việt), 'en' (English), 'auto' (Tự động)
OUTPUT_LANGUAGE=vi

# --- Cấu hình Mirror (bỏ ghi chú bên dưới nếu cần sử dụng mirror tăng tốc mạng) ---

# # Docker Hub Mirror (lưu ý dấu gạch chéo ở cuối)
# DOCKER_REGISTRY=docker.1ms.run/

# # GitHub Container Registry Mirror (lưu ý dấu gạch chéo ở cuối)
# GHCR_REGISTRY=ghcr.nju.edu.cn/

# # Debian apt Mirror
# APT_MIRROR=mirrors.aliyun.com

# # PyPI Mirror
# PYPI_INDEX_URL=https://mirrors.cloud.tencent.com/pypi/simple

# # npm Mirror (lưu ý dấu gạch chéo ở cuối)
# NPM_REGISTRY=https://registry.npmmirror.com/
